# Copy this file to .env and fill in your values. Never commit .env to git!
# In terminal (from backend folder): copy .env.example .env   (Windows) or  cp .env.example .env   (Mac/Linux)

# Secret key used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=your-super-secret-key-change-this-in-production

# MongoDB connection. Default local database.
MONGODB_URI=mongodb://127.0.0.1:27017/gosport

# Port on which the backend server runs.
PORT=5000

# Resend API for email verification (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=GoSport <onboarding@resend.dev>

# Frontend origin used in verification email links, CORS, and cookies (no trailing slash).
FRONTEND_URL=http://localhost:3000
